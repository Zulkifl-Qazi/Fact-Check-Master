# X (Twitter) API Configuration
# To get a Bearer Token:
# 1. Go to https://developer.twitter.com/en/portal/dashboard
# 2. Create a new app (if you don't have one)
# 3. Go to "Keys and tokens" tab
# 4. Generate a "Bearer Token" under "Authentication Tokens & Keys"
# 5. Paste it below (keep it SECRET - never commit this file!)

X_API_BEARER_TOKEN=

# Email Configuration for Nodemailer
# Replace these with your actual email credentials

# SMTP Server Settings (Gmail example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Email Credentials
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# From Email Address (optional, defaults to SMTP_USER)
FROM_EMAIL=noreply@factcheckmaster.com

# Note: For Gmail:
# 1. Enable 2-Step Verification in your Google Account
# 2. Generate an "App Password" in Security settings
# 3. Use the App Password (not your regular password) for SMTP_PASS

# Other configurations (optional)
ADMIN_KEY=
EXPORT_KEY=
