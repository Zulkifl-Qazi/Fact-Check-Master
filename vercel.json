{
  "images": {
    "sizes": [320, 640, 800, 1200, 1920],
    "domains": [
      "bswvizupdnwrdhtnmgqw.supabase.co"
    ],
    "minimumCacheTTL": 86400
  },
  "functions": {
    "api/posts.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}