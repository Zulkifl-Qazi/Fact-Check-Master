{
  "functions": {
    "api/posts.js": {
      "maxDuration": 30
    },
    "api/articles.js": {
      "maxDuration": 10
    },
    "api/sync-facebook.js": {
      "maxDuration": 25
    }
  },
  "crons": [
    {
      "path": "/api/sync-facebook",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/post/:id",
      "destination": "/api/share-preview.js?type=post&id=:id"
    },
    {
      "source": "/articles/:slug",
      "destination": "/api/share-preview.js?type=article&slug=:slug"
    },
    {
      "source": "/((?!api/|google.*\\.html|sitemap\\.xml|ads\\.txt|robots\\.txt).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}